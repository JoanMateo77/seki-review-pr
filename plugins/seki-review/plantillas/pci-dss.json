      "siFalla": {
        "etiqueta": "issue",
        "bloqueante": true,
        "tema": "security"
      }
    },
    {
      "id": "P5-trazabilidad",
      "pregunta": "Is the origin of the operation recorded (merchant, channel, the payer's real IP)?",
