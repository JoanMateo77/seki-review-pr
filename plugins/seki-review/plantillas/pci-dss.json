        "bloqueante": false
      }
    },
    {
      "id": "P6-control-de-cambio",
      "pregunta": "Is the change tied to a finding or ticket, with a deployment and rollback plan?",
      "evidencia": "The PR description",
      "reglas": [],
      "siFalla": {
        "etiqueta": "suggestion",
        "bloqueante": false
      }
    }
  ]
