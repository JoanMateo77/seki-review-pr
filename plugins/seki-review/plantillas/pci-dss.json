      "reglas": [],
      "siFalla": {
        "etiqueta": "issue",
        "bloqueante": true,
        "tema": "security"
      }
    },
    {
      "id": "P2-monto",
      "pregunta": "Does the server decide the amount (not the client)?",
      "evidencia": "Origin of the value that is charged or settled",
      "reglas": [],
      "siFalla": {
        "etiqueta": "issue",
        "bloqueante": true,
        "tema": "security"
      }
    },
    {
      "id": "P3-idempotencia",
      "pregunta": "Does repeating the request create a second transaction?",
      "evidencia": "Duplicate guard or idempotency key",
      "reglas": [],
      "siFalla": {
        "etiqueta": "issue",
        "bloqueante": true
      }
    },
    {
      "id": "P4-logs",
      "pregunta": "Do the new or touched logs avoid PAN, CVV, API keys and full personal data?",
      "evidencia": "The log line",
