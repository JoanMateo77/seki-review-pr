{
  "id": "pci-dss",
  "version": 1,
  "titulo": "PCI DSS",
  "idioma": "en",
  "siempre": false,
  "cubre": ["seguridad"],
  "aplicaA": [
    "**/*pago*",
    "**/*Pago*",
    "**/*payment*",
    "**/*Payment*",
    "**/*transac*",
    "**/*Transac*",
    "**/*merchant*",
    "**/*Merchant*",
    "**/*checkout*",
    "**/*Checkout*",
    "**/*pago*/**",
    "**/*Pago*/**",
    "**/*payment*/**",
    "**/*Payment*/**",
    "**/*transac*/**",
    "**/*Transac*/**",
    "**/*merchant*/**",
    "**/*Merchant*/**",
    "**/*checkout*/**",
    "**/*Checkout*/**"
  ],
  "excluir": [
    "**/__tests__/**",
    "**/*.spec.*",
    "**/*.test.*"
  ],
  "items": [
    {
      "id": "P1-credenciales",
      "pregunta": "Do API keys, secrets and tokens stay server-side (never in the browser, a URL or a log)?",
